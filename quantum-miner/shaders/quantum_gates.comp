#version 450
// HCScoin: Quantum circuit gate application (Clifford+T).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Statevector buffer (complex f32 pairs, size 2^qubits)
layout(std430, binding = 0) buffer StateBuffer { float state[]; };

// Gate parameters
layout(push_constant) uniform PushConstants {
    uint gate_type;  // 0=H, 1=X, 2=Z, 3=S, 4=T, 5=CNOT
    uint wire;       // target wire for single-qubit gates
    uint control;    // control wire (CNOT)
    uint target;     // target wire (CNOT)
    uint qubits;     // total qubits
    uint size;       // 1u << qubits
} params;

const float FRAC_1_SQRT_2 = 0.70710677;

vec2 load_amp(uint i) {
    return vec2(state[2*i], state[2*i+1]);
}
void store_amp(uint i, vec2 v) {
    state[2*i] = v.x;
    state[2*i+1] = v.y;
}

void hadamard(uint i0, uint i1) {
    vec2 a = load_amp(i0);
    vec2 b = load_amp(i1);
    vec2 s = a + b;
    vec2 d = a - b;
    store_amp(i0, s * FRAC_1_SQRT_2);
    store_amp(i1, d * FRAC_1_SQRT_2);
}

void pauli_x(uint i0, uint i1) {
    vec2 a = load_amp(i0);
    vec2 b = load_amp(i1);
    store_amp(i0, b);
    store_amp(i1, a);
}

void pauli_z(uint i0, uint i1) {
    vec2 a = load_amp(i0);
    vec2 b = load_amp(i1);
    store_amp(i0, a);
    store_amp(i1, vec2(-b.x, -b.y));
}

void s_gate(uint i0, uint i1) {
    vec2 a = load_amp(i0);
    vec2 b = load_amp(i1);
    store_amp(i0, a);
    store_amp(i1, vec2(-b.y, b.x));
}

void t_gate(uint i0, uint i1) {
    vec2 a = load_amp(i0);
    vec2 b = load_amp(i1);
    store_amp(i0, a);
    float re = (b.x - b.y) * FRAC_1_SQRT_2;
    float im = (b.x + b.y) * FRAC_1_SQRT_2;
    store_amp(i1, vec2(re, im));
}

void main() {
    uint tid = gl_GlobalInvocationID.x;
    uint total_pairs = params.size >> 1;
    if (tid >= total_pairs) return;

    uint q = (params.gate_type == 5) ? params.target : params.wire;
    uint tmask = 1u << q;
    uint lower = tid & (tmask - 1u);
    uint upper = (tid >> q) << (q + 1u);
    uint i0 = upper | lower;
    uint i1 = i0 | tmask;

    switch (params.gate_type) {
        case 0: hadamard(i0, i1); break;
        case 1: pauli_x(i0, i1); break;
        case 2: pauli_z(i0, i1); break;
        case 3: s_gate(i0, i1); break;
        case 4: t_gate(i0, i1); break;
        case 5: {
            uint cmask = 1u << params.control;
            if ((i0 & cmask) != 0) {
                pauli_x(i0, i1);
            }
            break;
        }
    }
}

