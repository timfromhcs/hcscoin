#version 450
// HCScoin: SHA-256d proof-of-work kernel.
// Applies double-SHA-256 to an 80-byte (legacy) block header and checks
// against the target. Grinds nNonce until the PoW is satisfied.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Input: 80-byte block header template (nVersion through nNonce fixed,
// with nNonce at offset 76 overwritten per work-item).
layout(std430, binding = 0) buffer HeaderBuffer { uint header[]; };

// Output: the winning nonce + hash (or all zeros if none found)
layout(std430, binding = 1) buffer ResultBuffer { uint result_nonce; uint result_hash[8]; };

// Target: 8 uint32s (little-endian 256-bit)
layout(std430, binding = 2) buffer TargetBuffer { uint target[8]; };

// Shared SHA-256 round constants
const uint K[64] = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
};

uint rotl(uint x, uint n) { return (x << n) | (x >> (32 - n)); }
uint rotr(uint x, uint n) { return (x >> n) | (x << (32 - n)); }
uint Ch(uint x, uint y, uint z) { return (x & y) ^ (~x & z); }
uint Maj(uint x, uint y, uint z) { return (x & y) ^ (x & z) ^ (y & z); }

void sha256_compress(inout uint s[8], uint w[64]) {
    uint a = s[0], b = s[1], c = s[2], d = s[3];
    uint e = s[4], f = s[5], g = s[6], h = s[7];
    for (uint i = 0; i < 64; ++i) {
        uint S1 = rotr(e,  6) ^ rotr(e, 11) ^ rotr(e, 25);
        uint ch  = Ch(e, f, g);
        uint t1  = h + S1 + ch + K[i] + w[i];
        uint S0  = rotr(a,  2) ^ rotr(a, 13) ^ rotr(a, 22);
        uint maj = Maj(a, b, c);
        uint t2  = S0 + maj;
        h = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }
    s[0] += a; s[1] += b; s[2] += c; s[3] += d;
    s[4] += e; s[5] += f; s[6] += g; s[7] += h;
}

void dsha256(uint data[20], out uint out_hash[8]) {
    uint s[8] = {
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    };
    uint w[64];

    // First block: 64 bytes (16 uints)
    for (uint i = 0; i < 16; ++i) w[i] = data[i];
    sha256_compress(s, w);

    // Second block: 16 bytes (4 uints) + padding + 640-bit length
    for (uint i = 0; i < 4; ++i) w[i] = data[16 + i];
    w[4] = 0x80000000;
    for (uint i = 5; i < 15; ++i) w[i] = 0;
    w[15] = 80 * 8; // 640
    sha256_compress(s, w);

    uint mid[8];
    for (uint i = 0; i < 8; ++i) mid[i] = s[i];

    // Second SHA-256 pass: 32 bytes (8 uints) + padding + 256-bit length
    s[0] = 0x6a09e667; s[1] = 0xbb67ae85; s[2] = 0x3c6ef372; s[3] = 0xa54ff53a;
    s[4] = 0x510e527f; s[5] = 0x9b05688c; s[6] = 0x1f83d9ab; s[7] = 0x5be0cd19;
    for (uint i = 0; i < 8; ++i) w[i] = mid[i];
    w[8] = 0x80000000;
    for (uint i = 9; i < 15; ++i) w[i] = 0;
    w[15] = 32 * 8; // 256
    sha256_compress(s, w);

    for (uint i = 0; i < 8; ++i) out_hash[i] = s[i];
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    // Each work item tries a different nonce
    uint nonce = id;
    uint hdr[20];
    for (uint i = 0; i < 20; ++i) hdr[i] = header[i];
    hdr[19] = nonce; // nNonce at word offset 19 (80 bytes = 20 uint32s)

    uint result[8];
    dsha256(hdr, result);

    // Little-endian comparison with target
    bool ok = true;
    for (int i = 7; i >= 0; --i) {
        if (result[i] < target[i]) break;
        if (result[i] > target[i]) { ok = false; break; }
    }
    if (ok) {
        result_nonce = nonce;
        for (int i = 0; i < 8; ++i) result_hash[i] = result[i];
    }
}
